# ─────────────────────────────────────────────────────────────────────────────
# Módulo de Trámites de Posgrado — variables de entorno (TP-211 · SC02-T11)
# Copiar a .env y completar:   cp .env.example .env
# .env NO se sube al repositorio. Aquí solo hay valores de ejemplo.
# Detalle de cada variable en DEPLOY.md (sección 3).
# ─────────────────────────────────────────────────────────────────────────────

# ── docker-compose ──────────────────────────────────────────────────────────
TAG=latest
BACKEND_PORT=8080
FRONTEND_PORT=8081
# Carpeta del repositorio tramites-frontend, relativa a este archivo
FRONTEND_DIR=../tramites-frontend
# Docker Compose 2.3x+ construye con "bake", que bloquea leer FRONTEND_DIR por estar
# fuera de esta carpeta ("additional privileges requested"). 0 permite ese build.
BUILDX_BAKE_ENTITLEMENTS_FS=0

# ── Solo perfil local (MySQL del compose) ───────────────────────────────────
# Base compartida Trámites + Matrícula (acuerdo TP-208). Misma versión que el
# servidor compartido (confirmar con el ing. Matías, TP-149).
MYSQL_VERSION=8.4.11
# Obligatoria en el perfil local. Generar con: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=posgrados
MYSQL_PORT=3307

# ── Base de datos (obligatorias) ────────────────────────────────────────────
# Perfil local: host "mysql" (el servicio del compose) y la base MYSQL_DATABASE.
# Perfil institucional: el host, base y usuario que entregue la UFPS.
DB_URL=jdbc:mysql://mysql:3306/posgrados?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
# Usuario con permisos solo sobre las tablas tp_* (DEPLOY.md, sección 6)
DB_USERNAME=tramites_app
# Obligatoria. Generar con: openssl rand -base64 24
DB_PASSWORD=
# Pool HikariCP (ver docs/POOL_CONEXIONES.md)
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
# Solo emergencia: "update" temporal si la validación del esquema falla
DDL_AUTO=validate
# Versión de baseline de Flyway (TP-209, docs/MIGRACIONES.md):
# 0 = BD nueva o compartida con Matrícula (institucional y perfil local): corren
#     V1 y V2 y se crean las tablas tp_*. Es el valor por defecto.
# 1 = la BD actual de Trámites (Railway), que ya tiene las tablas sin prefijo:
#     se salta V1 y V2 las renombra a tp_* conservando los datos.
#     También 1 si las tablas tp_* ya se crearon con el DDL entregado a
#     Matrícula (docs/entrega-matricula/02_ddl_tablas_tramites.sql).
FLYWAY_BASELINE_VERSION=0

# ── Seguridad (obligatoria) ─────────────────────────────────────────────────
# 32 caracteres o más. Generar con: openssl rand -base64 48
JWT_SECRET=

# ── Servidor ────────────────────────────────────────────────────────────────
# Puerto interno del backend. El compose lo fija en 8080 dentro del contenedor;
# el puerto publicado en el host es BACKEND_PORT. Solo cambia fuera del compose.
PORT=8080
# Nunca "dev" en producción: activa el login demo sin contraseña
SPRING_PROFILES_ACTIVE=local
# URL pública del frontend: origen permitido por CORS y enlace del QR de certificados
CORS_ORIGIN=http://localhost:8081
FRONTEND_URL=http://localhost:8081

# ── Frontend ────────────────────────────────────────────────────────────────
# URL pública del backend tal como la ve el navegador del usuario (termina en /api)
API_URL=http://localhost:8080/api
# Login con Google (opcional; lo usan backend y frontend)
GOOGLE_CLIENT_ID=
# Solo en el build de la imagen. Debe ser false en la entrega (true = usuarios demo)
REACT_APP_DEMO_MODE=false

# ── Módulo de Matrícula (SC-03; obligatorias en producción) ─────────────────
# mock = datos simulados (solo pruebas) | http = API real de Matrícula
MATRICULA_MODO=mock
# Incluye el prefijo de la aplicación, ej. https://host/posgrados-project
MATRICULA_URL=
# Cuenta técnica con rol Servicio Tramites en Matrícula
MATRICULA_USUARIO=
MATRICULA_PASSWORD=
# true solo con MATRICULA_MODO=http
MATRICULA_SINCRONIZAR=false

# ── Almacenamiento de documentos (Supabase) ─────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=tramites-documentos

# ── Pagos (Wompi) ───────────────────────────────────────────────────────────
WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_KEY=test_integrity_XXXXXXXXXXXX
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=http://localhost:8081/pago/resultado

# ── Correo SMTP (opcional) ──────────────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Opcionales con valor por defecto (descomentar solo para cambiarlos) ─────
# SHOW_SQL=false
# MAIL_TIMEOUT_MS=5000
# MATRICULA_TIMEOUT_CONEXION_MS=2000
# MATRICULA_TIMEOUT_RESPUESTA_MS=5000
# MATRICULA_MAX_REINTENTOS=2
# MATRICULA_PRESUPUESTO_MS=15000
# MATRICULA_SNAPSHOT_VIGENCIA_HORAS=24
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0
